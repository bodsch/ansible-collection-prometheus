#jinja2: trim_blocks: True, lstrip_blocks: True
---
# {{ ansible_managed }}

{% if promscout_network_cidr is defined and
      promscout_network_cidr | string | length > 0 %}
network_cidr: {{ promscout_network_cidr }}
{% endif %}
{% if promscout_ports is defined and
      promscout_ports | count > 0 %}
ports:
  {% for x in promscout_ports %}
  - {{ x }}
  {% endfor %}
{% endif %}
{% if promscout_metrics_paths is defined and
      promscout_metrics_paths | count > 0 %}
metrics_paths:
  {% for x in promscout_metrics_paths %}
  - {{ x }}
  {% endfor %}
{% endif %}
{% if promscout_interval is defined and
      promscout_interval | string | length > 0 %}
interval: {{ promscout_interval }}
{% endif %}
{% if promscout_timeout is defined and
      promscout_timeout | string | length > 0 %}
timeout: {{ promscout_timeout }}
{% endif %}
{% if promscout_listen is defined and
      promscout_listen | string | length > 0 %}
listen_address: "{{ promscout_listen }}"
{% endif %}

{% set _log_format = "json" %}
{% if promscout_log_format is defined and
      promscout_log_format | string | length > 0 and
      promscout_log_format in ["json", "text"] %}
  {% set _log_format = promscout_log_format %}
{% endif %}
log_format: {{ _log_format }}

{% if promscout_log_level is defined and
      promscout_log_level | string | length > 0 %}
log_level: {{ promscout_log_level }}
{% endif %}
{% if promscout_max_workers is defined and
      promscout_max_workers | string | length > 0 %}
max_workers: {{ promscout_max_workers }}
{% endif %}

{% if promscout_version is version_compare('2.0', '>=') %}
  {% if promscout_validate_workers is defined and
        promscout_validate_workers | string | length > 0 %}
# Maximum number of parallel HTTP validation workers (validate stage).
validate_workers: {{ promscout_validate_workers }}
  {% endif %}
  {% if promscout_cache_file is defined and
        promscout_cache_file | string | length > 0 %}
# Optional path to a target cache file. When set, validated targets are
# persisted after every discovery cycle and reloaded on startup, so the
# HTTP-SD endpoint serves results immediately (warm start) instead of
# staying empty until the first scan completes. Leave empty to disable.
cache_file: {{ promscout_cache_file }}
  {% endif %}
  {% if promscout_guess_job is defined and
        promscout_guess_job | string | length > 0 %}
# Best-effort "job" label guessing (opt-in, default false).
#
# The service identity of each target is always derived from its exposed
# metrics and published as __meta_promscout_{exporter,version,source}
# labels for use in Prometheus relabel_configs. When guess_job is true,
# the derived exporter name is additionally used as the "job" label; when
# false, "job" stays at the neutral default "promscout".
#
# Derivation order: target_info.service_name (OpenTelemetry) >
# <name>_build_info > dominant metric namespace prefix.
guess_job: false
  {% endif %}
{% endif %}
