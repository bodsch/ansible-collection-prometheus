# Configuration options for inbound listeners.
# The legacy frontend section and listener ports under metrics and mgmt remain
# supported for compatibility, but are deprecated. A matching listeners entry
# takes precedence over those legacy values.
#   # The default, metrics, and mgmt entries are built-in and can be customized here.
# listeners:
#   # default is built-in and the default frontend for all defined backends
#   default:
#     # protocol defines the protocol used by the listener, and defaults to http
#     protocol: http
#     # port is the port the listener uses. default uses 8480 by default
#     port: 8480
#     # address is empty by default, meaning listen on all interfaces.
#     address: ''
#     # tls_port value of 0 means disabled. A value > 0 starts only when a
#     # mapped backend provides a certificate and key. default uses 8483 by default
#     tls_port: 8483
#     # tls_address is empty by default, meaning listen on all interfaces.
#     tls_address: ''
#     # tls_watch_interval is the backstop poll for out-of-band cert/key
#     # rotation (e.g. certbot). FS events accelerate detection where supported.
#     # Changes are hot-swapped without restart. default 30s; 0 disables
#     tls_watch_interval: 30s
#     # tls_runtime_certs serves tls_port even when no mapped backend provides a
#     # certificate file; certificates are then supplied to the running process
#     # (e.g. by the Kubernetes controller from Secrets). default false
#     tls_runtime_certs: false
#     # connections_limit defines the maximum number of concurrent connections
#     # the listener may handle at any time. 0 means unlimited
#     connections_limit: 0
#
#     # read_header_timeout defines the amount of time allowed to read request headers.
#     read_header_timeout: 10s
#
#     # read_timeout bounds the time allowed to read a whole request, body included.
#     # 0 sets no bound. Default: 0
#     read_timeout: 0s
#
#     # idle_timeout closes a keep-alive connection that waits this long for its next
#     # request. 0 keeps idle connections open indefinitely. Default: 2m
#     idle_timeout: 2m
#
#     # max_header_bytes caps the bytes read for a request's line and headers.
#     # 0 selects the net/http default of 1 MB. Default: 0
#     max_header_bytes: 0
#
#     # trusted_proxies lists the addresses and CIDRs of proxies in front of this
#     # listener. A connection from one of them is attributed to the client named
#     # by its Forwarded, X-Forwarded-For or X-Real-IP header; any other connection
#     # is attributed to its peer, whatever headers it carries. See docs/configuring.md
#     trusted_proxies: [ 10.0.0.0/8 ]
#
#     # proxy_protocol accepts a PROXY protocol v1/v2 header ahead of each connection,
#     # honored from every peer when trusted_proxies is empty and only from a trusted
#     # proxy otherwise. Default: false
#     proxy_protocol: false
#
#     # ip_acl_name applies a named ip_acls entry to every connection on this
#     # listener, including mgmt and metrics. none is not valid here.
#     # See docs/ip-acl.md
#     ip_acl_name: office
#
#     # path_normalization cleans each request path before routing it, and the
#     # cleaned path is what the origin receives. See docs/configuring.md
#     path_normalization:
#       # dot_segments removes '.' and '..' segments per RFC 3986 (normalize),
#       # refuses them with 400 (reject), or leaves them (off). Default: normalize
#       dot_segments: normalize
#       # merge_slashes collapses each run of slashes to one. Default: false
#       merge_slashes: false
#       # escaped_slashes forwards %2F as data within a segment (keep), refuses
#       # it with 400 (reject), or decodes it to a separator (unescape). Default: keep
#       escaped_slashes: keep
#
#     # max_request_body_size_bytes indicates the maximum allowed request body size.
#     # Use 0 for no body allowed, and < 0 for no maximum. Default: 10MB.
#     max_request_body_size_bytes: 10485760
#
#     # truncate_request_body_too_large truncates oversized bodies instead of returning 413.
#     # Default: false.
#     truncate_request_body_too_large: false
#
#     # http3 serves this listener's routes over HTTP/3 (QUIC) in addition to
#     # HTTP/1.1 and HTTP/2. Requires a working TLS endpoint, since QUIC has no
#     # cleartext mode. Responses on the TLS/TCP endpoint advertise the HTTP/3
#     # endpoint via Alt-Svc so clients upgrade on their own. See docs/http3.md
#     http3:
#       # enabled turns on the HTTP/3 endpoint. Default: false
#       enabled: false
#       # port is the UDP port to bind. Defaults to this listener's tls_port
#       port: 8483
#       # address is the IP for the UDP socket. Defaults to tls_address
#       address: ''
#       # advertised_port is the port published in Alt-Svc. Defaults to port.
#       # Set it when a load balancer or NAT presents a different port to
#       # clients than the one bound here
#       advertised_port: 0

#   # metrics:
#   # 8481 is the default port for metrics
#     # port: 8481
#     # address: ''
#   # mgmt:
#   # 8484 is the default management port
#     # port: 8484
#     # address: ''
#
#   # A listener with protocol mysql accepts MySQL wire-protocol connections
#   # and requires exactly one backend with provider mysql mapped to it via
#   # the backend's listener_names. TLS ports are not supported on mysql
#   # listeners (MySQL negotiates TLS in-band on the same port).
#   mysql1:
#     protocol: mysql
#     port: 8486
#     # address: ''
#     # connections_limit: 0
#     # mysql:
#       # The complete authentication exchange must finish within this timeout.
#       handshake_timeout: 10s
#       # read_timeout bounds an in-progress command read.
#       read_timeout: 30s
#       write_timeout: 30s
#       # idle_timeout independently bounds waiting for the next command.
#       idle_timeout: 5m
#       # MySQL packet framing is currently fixed at the protocol ceiling.
#       max_packet_size_bytes: 16777215
#       max_query_size_bytes: 1048576
#     # MySQL-specific options have no direct TRK_* environment mapping and a
#     # structured origin_url does not expand ${VARIABLE}. Authenticator users
#     # do support environment expansion. Relevant reloads restart and drain
#     # this listener rather than moving established sessions. On Kubernetes,
#     # keep a MySQL listener's origin and client credentials in a Secret
#     # rather than a shared ConfigMap.
#
#   # A listener with protocol postgres accepts PostgreSQL wire-protocol
#   # connections and requires exactly one mapped backend: one with provider
#   # postgres or timescaledb, or a User Router ALB over such backends (see
#   # examples/conf/postgres-user-router.yaml). TLS is negotiated in-band on
#   # the same port, so TLS ports are not supported.
#   postgres1:
#     protocol: postgres
#     port: 5432
#     # address: ''
#     # connections_limit: 0
#     # postgres:
#       # The startup and authentication exchange must finish within this timeout.
#       handshake_timeout: 10s
#       read_timeout: 30s
#       write_timeout: 30s
#       # idle_timeout bounds the wait for a client's next message.
#       idle_timeout: 5m
#       # statements larger than this are relayed without being analyzed or cached
#       max_query_size_bytes: 1048576
#       # With an authenticator, clients authenticate with SCRAM-SHA-256. A user
#       # stored as a PostgreSQL md5 hash can only log in when allow_md5 is set,
#       # and a plaintext exchange over a non-TLS connection only with
#       # allow_cleartext_without_tls. Both default to false.
#       allow_md5: false
#       allow_cleartext_without_tls: false
#
#   # A listener with protocol moq accepts MoQ Transport sessions over native
#   # QUIC on its UDP port; TLS is part of the QUIC handshake, so TLS ports are
#   # not supported, and a backend it serves must provide a certificate in its
#   # tls block. Several moq backends may share one listener: a session is
#   # routed by the AUTHORITY and PATH of its SETUP against each backend's hosts
#   # and paths. A moq listener may share its UDP port with an HTTP/3 endpoint,
#   # or another moq listener, as long as their drafts differ.
#   moq1:
#     protocol: moq
#     port: 443
#     # address: ''
#     # moq:
#       # the client's SETUP must arrive within this timeout
#       handshake_timeout: 5s
#       # the QUIC idle timeout of the listener's connections
#       idle_timeout: 2m
#       max_sessions: 10000
#       max_requests_per_session: 1024
#       # advertised to clients in SETUP
#       max_filter_ranges: 16
#       max_request_updates: 64
#       # accepted MoQ Transport drafts, most preferred first
#       drafts: [22, 21, 20]
#       # the MOQT_IMPLEMENTATION setup option; defaults to trickster
#       implementation: ''
#       # when the listener stops, each session gets a GOAWAY naming this moqt
#       # URI to continue at, and a new request is redirected there; empty has
#       # clients reconnect where they were. Changing it restarts nothing.
#       goaway_uri: ''
#
#   # A ClickHouse listener accepts the Native binary protocol and maps to one
#   # ClickHouse backend through that backend's listener_names option.
#   clickhouse-native:
#     protocol: clickhouse
#     port: 8487
#     # address: ''
#     # connections_limit: 0
#
#   # A flight-sql listener accepts Apache Arrow Flight SQL (gRPC) connections
#   # and maps to one InfluxDB backend through that backend's listener_names
#   # option. See /docs/influxdb.md for full details. InfluxDB 3.x only.
#   influx3-flight:
#     protocol: flight-sql
#     port: 8485
#     # address: ''
#     # connections_limit: 0
#
#   # A listener with protocol tcp relays each connection's bytes, unread, to
#   # its one mapped backend: a reverseproxy (rp) backend whose origin_url
#   # supplies the host and port to dial, or an alb backend (mechanism rr)
#   # whose pool members are such backends, each connection committed to one
#   # member by weighted round robin. See docs/configuring.md#stream-listeners
#   postgres:
#     protocol: tcp
#     port: 5432
#     # address: ''
#     # connections_limit bounds the connections relayed at once; for a udp
#     # listener it bounds the sessions held at once, 1024 when unset
#     # connections_limit: 0
#     # stream tunes the relay for the tcp, tls and udp protocols
#     stream:
#       # connect_timeout bounds the lookup and dial of the backend and, on a
#       # tls listener, the wait for the client's ClientHello. Default: 10s
#       connect_timeout: 10s
#       # idle_timeout closes a connection over which no byte has moved in
#       # either direction for this long, or ends a udp session that carried
#       # no datagram for this long. Default: none for tcp and tls, 60s for udp
#       idle_timeout: 0s
#
#   # A listener with protocol tls relays TLS connections unterminated: the
#   # server name the client offers selects the mapped backend whose hosts
#   # name it, or the one mapped backend with no hosts, and the backend
#   # terminates TLS itself. tls_port and tls_runtime_certs do not apply.
#   sni:
#     protocol: tls
#     port: 8443
#
#   # A listener with protocol udp relays each client's datagrams to its one
#   # mapped backend over a session of its own, ended once idle. A udp listener
#   # binds its own port space, so it may share a port number with a tcp one.
#   dns:
#     protocol: udp
#     port: 5353
